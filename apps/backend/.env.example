NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=0
DB_POOL_MAX=3
JWT_SECRET=change-me-to-a-long-random-string

# Exact browser origin allowlist for cookie + CSRF checks. Set HTTPS origins in production.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production requires a random JWT_SECRET (32+ characters), no STATIC_OTP,
# and a real OTP delivery integration. Test accounts are never seeded in production.

# Server-only ATS service credentials (never NEXT_PUBLIC_*).
ATS_ENDPOINT=https://ats-resume-api-cmkh.onrender.com
ATS_API_KEY=
ATS_MAX_PAGES=2

# Secret for the recruiter-view contact digests (HMAC-SHA256). Server-only:
# never NEXT_PUBLIC_*. Use a long random string in production.
CONTACT_PEPPER=change-me-to-a-long-random-string
